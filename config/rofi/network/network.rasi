/**
 * NetworkManager Rofi
 * Rose Pine style - bar layout
 */

configuration {
    show-icons: false;
}

@import "shared/colors.rasi"
@import "shared/fonts.rasi"


window {
    transparency: "real";

    location: east;
    anchor: east;

    width: 420px;

    x-offset: 0px;
    y-offset: 0px;

    padding: 0px;

    border: 0px;
    border-radius: 0px;

    background-color: @background;
}


mainbox {
    spacing: 15px;
    padding: 15px;

    children: [
        "inputbar",
        "listview"
    ];
}


inputbar {
    spacing: 10px;

    padding: 0px;

    background-color: transparent;

    children: [
        "textbox-prompt-colon",
        "prompt",
        "entry"
    ];
}


textbox-prompt-colon {
    str: "󰤨";

    padding: 10px 13px;

    background-color: @urgent;

    text-color: @background;
}


prompt {
    padding: 10px;

    background-color: @active;

    text-color: @background;
}


entry {
    padding: 10px;

    background-color: @background-alt;

    text-color: @foreground;
}


listview {
    spacing: 10px;

    scrollbar: false;

    layout: vertical;
}


element {
    padding: 14px 12px;

    border-radius: 8px;

    background-color: @background-alt;

    text-color: @foreground;
}


element selected.normal {
    background-color: @selected;

    text-color: @background;
}


element-text {
    font: "DejaVu Sans Mono 11";

    vertical-align: 0.5;

    horizontal-align: 0.0;

    text-color: inherit;
}
