#!/usr/bin/env bash

IS_SILENT=0
DO_CHECK=0

for arg in "$@"; do
    case "$arg" in
        --silent) IS_SILENT=1 ;;
        --is-muted) DO_CHECK=1 ;;
        --help|-h)
            echo "Usage: $0 [--silent|--is-muted]"
            exit 0
            ;;
    esac
done

if [[ $DO_CHECK == 1 ]]; then
    wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED \
        && echo true || echo false
    exit 0
fi

wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

IS_MUTED=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@)

[[ $IS_SILENT == 1 ]] && exit 0

if [[ "$IS_MUTED" == *"MUTED"* ]]; then
    MESSAGE="Microphone is muted"
    ICON="notification-microphone-sensitivity-muted"
else
    MESSAGE="Microphone is unmuted"
    ICON="notification-microphone-sensitivity-high"
fi

notify-send \
    --hint string:x-canonical-private-synchronous:microphone \
    --icon="$ICON" \
    --app-name="$0" \
    "Changed microphone state" "$MESSAGE"