{
  "layer": "top",
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "custom/capslock",
    "tray",
    "group/volume",
    //"bluetooth",
    //"network",
    "cpu",
    "memory",
    "battery",
    "disk",
    "custom/notification"
  ],
  "hyprland/workspaces": {
    "on-click": "activate",
	"format": "{icon}",
    "format-icons": {
        "1": "󰈹",
        "3": "󰅩",
        "4": "󰈙",
        "5": "󰭹",
        "6": "󰊴",
        "9": "󰝚",
        "default": "󰇘"
    },
  },
  "battery": {
    "interval": 60,
    "format": "{capacity}% {icon}",
    "format-icons": {
      "default": [
        "󰂎",
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ],
      "charging": [
        "󰢟",
        "󰢜",
        "󰂆",
        "󰂇",
        "󰂈",
        "󰢝",
        "󰂉",
        "󰢞",
        "󰂊",
        "󰂋",
        "󰂅"
      ]
    }
  },
  "bluetooth": {
    "format": " {status}",
    "format-disabled": "", // an empty format will hide the module
    "format-connected": " {num_connections}",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "exec kitty --title=blueman-manager -e blueman-manager "
  },
  "cpu": {
    "interval": 10,
    "format": " {}%",
    "max-length": 10,
    "on-click": "exec kitty --title=btop -e btop"
  },
  "memory": {
    "interval": 30,
    "format": " {used:0.1f}G/{total:0.1f}G",
    "tooltip-format": "{percentage}% used",
    "on-click": "exec kitty --title=btop -e btop"
  },
  "network": {
    "format": "",
    "format-wifi": "",
    "format-ethernet": "",
    "format-disconnected": "󰤭", //An empty format will hide the module.
    "tooltip-format": "{ifname} via {gwaddr} 󰊗",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
    "tooltip-format-ethernet": "{ifname} ",
    "tooltip-format-disconnected": "󰖪",
    "max-length": 50,
    "on-click": "exec kitty --title=mntui -e nmtui"
  },
  "clock": {
    "format": "󰥔 {:%a, %d. %b %I:%M %p}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "format": {
        "today": "<span color='#c4a7e7'><b>{}</b></span>"
      }
    },
    //"on-click": "exec firefox --app=https://calendar.google.com"
  },
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-muted": "",
    "format-icons": {
      "default": [
        "",
        ""
      ]
    },
    "ignored-sinks": [
      "Easy Effects Sink"
    ],
    "on-click": "pavucontrol",
    "on-click-right": "~/.config/waybar/scripts/volume-control.sh mute",
    "on-scroll-up": "~/.config/waybar/scripts/volume-control.sh up",
    "on-scroll-down": "~/.config/waybar/scripts/volume-control.sh down"
  },
  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal"
  },
  "group/volume": {
    "orientation": "horizontal",
    "modules": [
      "pulseaudio",
      "pulseaudio/slider"
    ]
  },
  "tray": {
    "icon-size": 15,
    "spacing": 10,
    "show-passive-items": true,
    "reverse-direction": true,
    "orders": {
      "ferdium": 97,
      "blueman": 98,
      "nm-applet": 99
    }
  },
  "custom/notification": {
    "tooltip": true,
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "escape": true
  },
  "custom/capslock": {
    "exec": "~/.config/waybar/scripts/capslock.sh",
    "return-type": "json",
    "interval": 0,
    "escape": true
  },
  "disk": {
    "interval": 30,
    "path": "/",
    "format": " {percentage_free}%",
    "unit": "GB",
    "tooltip": true,
    "tooltip-format": "Used: {specific_used:.1f} GB/{specific_total:.1f} GB\nFree: {specific_free:.1f} GB"
  },
}
