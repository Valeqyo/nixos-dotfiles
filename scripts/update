#!/usr/bin/env bash

set -e

cd ~/nixos-dotfiles

# Se qualcosa va storto, torna allo stato precedente
cleanup() {
    echo "Error or interruption: reverting flake.lock"
    git checkout flake.lock
    rm -f result
}
trap cleanup ERR INT TERM

echo "Updating flake..."
nix flake update

if git diff --quiet flake.lock; then
    echo "No flake updates available"
    trap - ERR INT TERM
    exit 0
fi

echo "Flake inputs changed:"
git diff flake.lock | grep -E '^\+.*"(lastModified|rev)"' || true

echo "Building new system..."
nixos-rebuild build --flake .#nixos-btw

echo "Package changes:"
nvd diff /run/current-system ./result

read -rp "Apply update? [y/N] " ans
if [[ "$ans" != "y" ]]; then
    echo "Aborted"
    cleanup
    trap - ERR INT TERM
    exit 0
fi

echo "Switching..."
sudo nixos-rebuild switch --flake .#nixos-btw

# Da qui in poi l'update è applicato: niente più revert automatico
trap - ERR INT TERM
rm -f result

echo "Saving changes..."
git add flake.lock
git commit -m "Update flake"
git push

echo "Done!"
